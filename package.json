{
  "name": "vexa",
  "version": "1.0.0",
  "description": "A tiny (< 3 kB), isomorphic, zero-dependency fetch client with built-in retries, request deduplication, AI streaming, and runtime schema validation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "fetch",
    "http-client",
    "isomorphic",
    "retry",
    "deduplication",
    "stream",
    "sse",
    "ai",
    "standard-schema",
    "typescript",
    "zero-dependencies"
  ],
  "author": "alsaeff",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alsaeff/vexa.git"
  },
  "bugs": {
    "url": "https://github.com/alsaeff/vexa/issues"
  },
  "homepage": "https://github.com/alsaeff/vexa#readme",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
